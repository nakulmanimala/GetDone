GETDONE_PORT=3080

# Where the app is reached from a browser. Must match the Authorised redirect
# URI in Google Cloud Console (with /api/auth/callback appended), and must be
# https unless it is localhost.
APP_ORIGIN=http://localhost:3080

# Google sign-in (see README.md "Team accounts with Google sign-in")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only accounts in this Google Workspace domain may sign in.
GOOGLE_ALLOWED_DOMAIN=entri.me
# Signs session cookies. generate with: openssl rand -hex 32
SESSION_SECRET=
# Optional; defaults to 30 days.
# SESSION_TTL_SECONDS=2592000

# S3 snapshot backup/sync (see README.md "S3 backup and sync")
AWS_PROFILE=default
AWS_REGION=us-east-1
S3_BUCKET=
# Each user's snapshot is stored at <prefix>/<google-user-id>/snapshot.json.enc
S3_SNAPSHOT_PREFIX=getdone/users
S3_USERS_KEY=getdone/users.json
# generate with: openssl rand -base64 32
SYNC_ENCRYPTION_KEY=
